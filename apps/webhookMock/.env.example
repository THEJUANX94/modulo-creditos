# Variables del mock del sistema externo (ADR 0020). Copiar a .env. .env no se versiona.

# Puerto del mock. La API apunta a él con WEBHOOK_URL=http://localhost:4000/webhooks/creditos.
PORT=4000

# El mismo secreto que WEBHOOK_SECRETO de apps/api/.env: con otro, cada envío responde 401.
WEBHOOK_SECRETO=whsec_CambiarPorBase64DeAlMenos32BytesAleatoriosXXXXXXXXXXXXXX

# Comportamiento al arrancar (se cambia en vivo desde http://localhost:4000):
# acepta | falla | rechaza | lento | intermitente | fallaPrimeros
MOCK_MODO=acepta
# En fallaPrimeros: cuántos envíos de cada evento fallan antes de aceptar (1 a 10).
MOCK_FALLAS_POR_EVENTO=2
# En lento: cuánto tarda en responder. Mayor que WEBHOOK_TIMEOUT_MS del worker (15 s).
MOCK_RETRASO_MS=20000
