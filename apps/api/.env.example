# Variables de la API y del worker del webhook. Copiar a .env y reemplazar las claves. .env no se versiona.
# Las validan src/config/ (configBase, config y configWorker) al arrancar: si falta una, el proceso
# no arranca y dice cuál. Cada proceso exige solo las suyas: la API no necesita las WEBHOOK_*, y el
# worker no necesita PORT, CORS_ORIGINS, TRUST_PROXY, JWT_SECRET ni DOCS_HABILITADA.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Login de la app, con mínimo privilegio. La clave es APP_DB_PASSWORD del .env de la raíz.
# trustServerCertificate=true solo en desarrollo (certificado autofirmado del contenedor).
DATABASE_URL="sqlserver://localhost:1433;database=ModuloCreditos;user=appCreditos;password={CambiarClaveApp#2026};encrypt=true;trustServerCertificate=true"

# Solo para `prisma db pull` en desarrollo (administrador). Nunca en producción.
DATABASE_ADMIN_URL="sqlserver://localhost:1433;database=ModuloCreditos;user=sa;password={CambiarClaveSa#2026};encrypt=true;trustServerCertificate=true"

# Orígenes del navegador que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Cuántos proxies hay delante de la API (Nginx = 1). 0 = ninguno.
TRUST_PROXY=0

# Clave HS256 de los access tokens: al menos 32 caracteres aleatorios. Para generarla:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CambiarPorUnaClaveAleatoriaDeAlMenos32Caracteres

# Solo para `pnpm -F @creditos/api usuarios:crear`: contraseña de los cuatro usuarios demo
# (asesor@, analista@, tesoreria@ y admin@creditos.test). Entre 12 y 128 caracteres.
USUARIOS_DEMO_CLAVE=CambiarClaveDemo2026

# ───────────── Worker del webhook (ADR 0018) ─────────────

# Receptor del evento credito.creado. https obligatorio con NODE_ENV=production.
WEBHOOK_URL=http://localhost:4000/webhooks/creditos

# Secreto de la firma (Standard Webhooks): whsec_ + base64 de al menos 32 bytes. El receptor tiene
# el mismo. Para generarlo:
#   node -e "console.log('whsec_' + require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_SECRETO=whsec_CambiarPorBase64DeAlMenos32BytesAleatoriosXXXXXXXXXXXXXX

# Política de envío (opcionales; estos son los valores por defecto).
# Intentos antes de FALLIDO, y espera base del backoff: base × 2^(n-1), con jitter de ±20 %.
WEBHOOK_MAX_INTENTOS=6
WEBHOOK_BACKOFF_BASE_MS=10000
# Espera máxima de la respuesta en cada intento (máximo 30000), y cada cuánto se lee el outbox.
WEBHOOK_TIMEOUT_MS=15000
WEBHOOK_INTERVALO_MS=2000
