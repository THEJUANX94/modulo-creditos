# Variables de la API. Copiar a .env y reemplazar las claves. .env no se versiona.
# Las valida src/config/config.ts al arrancar: si falta una, la API no arranca y dice cuál.

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Login de la app, con mínimo privilegio. La clave es APP_DB_PASSWORD del .env de la raíz.
# trustServerCertificate=true solo en desarrollo (certificado autofirmado del contenedor).
DATABASE_URL="sqlserver://localhost:1433;database=ModuloCreditos;user=appCreditos;password={App687b1f24ebdccb1db140f7c0#7};encrypt=true;trustServerCertificate=true"

# Solo para `prisma db pull` en desarrollo (administrador). Nunca en producción.
DATABASE_ADMIN_URL="sqlserver://localhost:1433;database=ModuloCreditos;user=sa;password={Saf69b6f44c6c2f7fb3ce3aaef#9};encrypt=true;trustServerCertificate=true"

# Orígenes del navegador que pueden llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Cuántos proxies hay delante de la API (Nginx = 1). 0 = ninguno.
TRUST_PROXY=0

JWT_SECRET=9E5a0Rpo_LczboKD4TbkCj4sZjAWsRSXFHduwkPWMGU-0-Ea5X8KxzNK7kEVzskw
USUARIOS_DEMO_CLAVE=DemoAt5TWrN3yY0m

# Worker del webhook (ADR 0018)
