# Variables del docker-compose (ADR 0022). .env no se versiona.
# `pnpm env:generar` crea .env a partir de este archivo con claves aleatorias, o agrega a un .env
# existente las variables que le falten, sin tocar las que ya tiene.
# Los valores de aquí son de ejemplo: no son secretos reales y no deben usarse fuera de una prueba.

# ───────────── SQL Server ─────────────

# Clave del administrador (sa). SQL Server exige al menos 8 caracteres con tres de estos cuatro
# grupos: mayúsculas, minúsculas, números y símbolos. Se fija al crear el volumen: cambiarla después
# exige recrearlo (docker compose down -v).
MSSQL_SA_PASSWORD=CambiarClaveSa#2026

# Clave del login de la app (appCreditos), que crea 001-crearBaseDatos.sql. El compose arma con ella
# la DATABASE_URL de la API y del worker. En desarrollo con pnpm, la de apps/api/.env es la misma.
APP_DB_PASSWORD=CambiarClaveApp#2026

# Puerto de SQL Server en la máquina local.
SQLSERVER_PORT=1433

# ───────────── Sistema completo ─────────────

# Puertos en la máquina: la web (con la API en /api y Swagger en /api/docs) y la página del mock.
WEB_PORT=8080
MOCK_PORT=4000

# Clave HS256 de los access tokens: al menos 32 caracteres aleatorios.
JWT_SECRET=CambiarPorUnaClaveAleatoriaDeAlMenos32Caracteres

# Secreto de la firma del webhook (Standard Webhooks): whsec_ + base64 de al menos 32 bytes. Lo usan
# el worker y el mock.
WEBHOOK_SECRETO=whsec_CambiarPorBase64DeAlMenos32BytesAleatoriosXXXXXXXXXXXXXX

# Contraseña de los cuatro usuarios demo (asesor@, analista@, tesoreria@ y admin@creditos.test), que
# crea el servicio usuariosDemo. Entre 12 y 128 caracteres.
USUARIOS_DEMO_CLAVE=CambiarClaveDemo2026
