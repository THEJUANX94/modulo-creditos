# Variables del docker-compose (infraestructura de desarrollo).
# Copiar a .env y reemplazar las claves. .env no se versiona.

# Clave del administrador (sa). SQL Server exige al menos 8 caracteres con mayúsculas,
# minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=CambiarClaveSa#2026

# Clave del login de la app (appCreditos), que crea 001-crearBaseDatos.sql.
# Tiene que coincidir con la de DATABASE_URL en apps/api/.env.
APP_DB_PASSWORD=CambiarClaveApp#2026

# Puerto de SQL Server en la máquina local.
SQLSERVER_PORT=1433
